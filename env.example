# Plantilla de configuración. El asistente (setup.ps1 / setup.sh) genera `.env` por vos;
# esto existe para leer el contrato completo o para armar el archivo a mano:
#
#   cp env.example .env     (Linux/macOS)
#   Copy-Item env.example .env   (PowerShell)

# --- host -------------------------------------------------------------------
# Carpeta del host donde viven los .nc, las salidas y los artefactos de los jobs
# (`.media/`). Adentro del contenedor siempre es /data. Usá barras (/) aunque estés en
# Windows: un solo volumen cubre datos, salidas y caché.
DATA_DIR=D:/climate3d-data
# Puerto local. La app se publica en 127.0.0.1, nunca en la red.
PORT=8080

# --- contenedor (no hace falta tocarlo) -------------------------------------
# La imagen ya fija esto. Queda acá para que se vea el contrato completo.
# CLIMATE3D_DATOS=/data
# CLIMATE3D_MEDIA=/data/.media
# CLIMATE3D_PYTHON=/app/.venv/bin/python

# --- credenciales (todas opcionales) ----------------------------------------
# NASA FIRMS, gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Desbloquea el producto "focos de calor".
FIRMS_MAP_KEY=
# Copernicus CDS, gratis: https://cds.climate.copernicus.eu/
# Solo lo usa descargar/descargar_era5.py.
CDSAPI_KEY=
# Earthdata Login, gratis: https://urs.earthdata.nasa.gov/
# Solo lo usa descargar/pace_landvi.py (follaje PACE).
EARTHDATA_USER=
EARTHDATA_PASSWORD=
