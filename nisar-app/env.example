# Copiar a nisar-app/.env y completar. El .env real NO se versiona.

# Earthdata Login: obligatorio para bajar los .h5 desde ASF.
# El browse publico y la busqueda no piden credenciales.
# Cuenta gratuita: https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# FIRMS MAP_KEY: solo para los focos de calor del producto incendio.
# Gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Tambien se puede guardar en datos/firms_map_key.txt.
FIRMS_MAP_KEY=

# Interprete que corre el pipeline. Sin esto se usa el .venv del repo.
# CLIMATE3D_PYTHON=C:\ruta\al\repo\.venv\Scripts\python.exe

# Raiz de los .h5 NISAR. Sin esto: E:\nisar en Windows, <datos>/nisar en Linux.
# CLIMATE3D_NISAR=E:\nisar

# Raiz de artefactos de jobs. Sin esto: nisar-app/var/media.
# NISAR_MEDIA=C:\ruta\a\media

# Raiz de la cache de browse. Sin esto: nisar-app/var/nisar/cache.
# NISAR_BROWSE_CACHE=C:\ruta\a\cache
