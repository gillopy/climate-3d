{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "climate3d-demo",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
